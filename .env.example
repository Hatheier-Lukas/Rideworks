# PostgreSQL for persistent orders and stock reservations
DATABASE_URL=
# Optional direct Neon connection, preferred by schema migrations
DATABASE_URL_UNPOOLED=
DATABASE_SSL=true

# Configure before accepting bank-transfer orders
BANK_ACCOUNT_NAME=
BANK_IBAN=
BANK_BIC=

# Resend sender must be verified before sending real mail
RESEND_API_KEY=
MAIL_FROM=

# Google OAuth for admin sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADMIN_EMAIL=hatheierlukas@gmail.com
APP_URL=https://your-domain.example
SESSION_SECRET=

# Optional username/password admin login (store only the generated scrypt hash)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
